# Application
APP_NAME=Autonomous Multi-Agent Support System
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# LLM Configuration
# Options: "gemini" (Google AI Studio) or "openai" (local OpenAI-compatible endpoint like Ollama)
LLM_PROVIDER=openai

# For Gemini provider:
GOOGLE_API_KEY=your-google-api-key-here

# For OpenAI-compatible provider (local):
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11435/v1
MODEL_NAME=llama3

# Common settings:
TEMPERATURE=0.2
MAX_TOKENS=500

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/support_system
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
POSTGRES_USER=support_user
POSTGRES_PASSWORD=support_password

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Workflow Configuration
# Confidence threshold below which requests escalate to human review.
# NOTE: this static value is only used when no calibrated threshold
# artifact exists yet (see CALIBRATION.md) — once you run
# scripts/compute_calibrated_threshold.py, DecisionEngine prefers the
# calibrated value instead.
ESCALATION_THRESHOLD=0.7
# Confidence threshold for knowledge retrieval
KNOWLEDGE_CONFIDENCE_THRESHOLD=0.8

# Calibrated Escalation Configuration (see CALIBRATION.md)
# Target: at most this fraction of non-escalated requests should be wrong
CALIBRATION_TARGET_RISK=0.10
# Confidence level for the guarantee: (1 - delta) = 95% by default
CALIBRATION_DELTA=0.05
